# Telegram
TELEGRAM_BOT_TOKEN=
# Optional. Filled = only this chat. Empty = all chats, each with separate data/chats/<chat>/ memory.
TELEGRAM_ALLOWED_CHAT_ID=
# Optional. Empty = auto-detect through Telegram getMe.
TELEGRAM_BOT_USERNAME=
# Optional. Comma-separated chat IDs where every message is stored for full context. Empty = store only bot interactions/skills/commands. Use * to capture all allowed chats.
TELEGRAM_FULL_CAPTURE_CHAT_IDS=

# LLM provider: works for OpenAI, OpenRouter or custom OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_SUPPORTS_TOOLS=true
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=1

# Agent behavior
AGENT_DATA_DIR=./data
AGENT_TIMEZONE=Europe/Amsterdam
AGENT_MAX_REPLY_CHARS=900
AGENT_MAX_TOOL_STEPS=6
AGENT_IDENTITY_MAX_CHARS=5000
TELEGRAM_IMAGE_MAX_BYTES=5242880

# Context management
CONTEXT_MAX_CHARS=14000
RECENT_MESSAGES_CONTEXT_LIMIT=30
RECENT_MESSAGES_FILE_LIMIT=300
MESSAGES_TO_SUMMARIZE_ON_ROTATION=200
SUMMARY_MAX_CHARS=3000
FACTS_MAX_CHARS=2500

# Mood diary
MOOD_UPDATE_EVERY_MESSAGES=20
INTERACTION_SUMMARY_EVERY_MESSAGES=50

# Declarative micro-skills HTTP actions. Empty = HTTP actions disabled.
# Comma-separated origins, or * to allow any origin with size/time limits.
SKILL_HTTP_ALLOWED_ORIGINS=
SKILL_HTTP_TIMEOUT_MS=10000
SKILL_HTTP_MAX_REQUEST_BYTES=131072
SKILL_HTTP_MAX_RESPONSE_BYTES=1048576
