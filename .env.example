# Russian comments: docs/ru/configuration.md

# --- Telegram settings ---
# Your Telegram bot token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=
# Restrict access by chat. Use one ID or several separated by commas. Empty = all chats are allowed. Each chat always has separate memory
TELEGRAM_ALLOWED_CHAT_ID=
# Bot username without @. Empty = detected automatically at startup through getMe
TELEGRAM_BOT_USERNAME=
# Comma-separated chat IDs for storing all processed messages. * = all chats. If empty, called mode stores requests, commands, and skill triggers; smart mode also stores background conversation
TELEGRAM_FULL_CAPTURE_CHAT_IDS=

# --- LLM settings ---
# API base URL (supports OpenAI, OpenRouter, DeepSeek, and other OpenAI-compatible APIs)
LLM_BASE_URL=https://api.openai.com/v1
# API key from your model provider
LLM_API_KEY=
# Exact ID of a model available from the selected provider. Agent actions require tool calling support
LLM_MODEL=
# Whether the selected model supports function/tool calling
LLM_SUPPORTS_TOOLS=true
# LLM request timeout in milliseconds
LLM_TIMEOUT_MS=45000
# Number of retries for API requests after network errors
LLM_MAX_RETRIES=1
# Additional LLM retries inside the tool loop before falling back to a response without tools
LLM_TOOL_LOOP_RETRIES=1

# --- Agent behavior ---
# Local data directory (settings, skills, history, and secrets)
AGENT_DATA_DIR=./data
# IANA time zone for the scheduler and local time (for example, Europe/Moscow)
AGENT_TIMEZONE=Europe/Moscow
# Language for new chats: ru or en. Change it for a particular chat with /agentur language
AGENT_DEFAULT_LOCALE=ru
# Maximum number of tool steps per response (prevents the agent from looping indefinitely)
AGENT_MAX_TOOL_STEPS=15
# Maximum size in bytes of a Telegram image accepted for analysis
TELEGRAM_IMAGE_MAX_BYTES=5242880
# Maximum size in bytes of a downloaded document
TELEGRAM_ATTACHMENT_MAX_BYTES=5242880
# Maximum number of payload items per reply to Telegram. Telegram media group limit: 10
TELEGRAM_SEND_MAX_ITEMS=10

# --- Context management ---
# Hard context window limit for the selected model: input + response + safety reserve
CONTEXT_WINDOW_TOKENS=32000
# Working text prompt budget. User input can exceed it within the remaining context window; memory cannot
CONTEXT_BUDGET_TOKENS=12000
# Maximum number of generated response tokens. Also reserved in the context window
REPLY_MAX_TOKENS=900
# Maximum number of messages stored in recent.jsonl
RECENT_MESSAGES_FILE_LIMIT=300
# Number of messages to summarize when clearing and rotating the history
MESSAGES_TO_SUMMARIZE_ON_ROTATION=200
# Maximum length of the chat summary file, summary.md, in characters
SUMMARY_FILE_MAX_CHARS=3000

# --- Mood diary ---
# How often to update the chat mood estimate, in messages
MOOD_UPDATE_EVERY_MESSAGES=20
# How often to summarize and clear interaction logs in chats not listed in TELEGRAM_FULL_CAPTURE_CHAT_IDS
INTERACTION_SUMMARY_EVERY_MESSAGES=50

# --- HTTP requests from skills ---
# Comma-separated allowed origins, such as https://api.example.com (scheme + host + optional port, no path). Empty = HTTP requests from skills and the agent's HTTP tool are disabled. * = any public origin, subject to the other checks
SKILL_HTTP_ALLOWED_ORIGINS=
# Additional blocked hostnames, separated by commas. Exact, case-insensitive matching without a port
HTTP_BLOCKED_HOSTS=
# Explicitly allowed private/localhost hosts. Use only for trusted internal infrastructure
HTTP_ALLOWED_PRIVATE_HOSTS=
# Maximum HTTP request duration in milliseconds
SKILL_HTTP_TIMEOUT_MS=10000
# Maximum request body size in bytes
SKILL_HTTP_MAX_REQUEST_BYTES=131072
# Maximum response body size in bytes
SKILL_HTTP_MAX_RESPONSE_BYTES=1048576

# --- Trusted MCP skill ---
# Enable the native trusted skill in skills/catalog/mcp. Empty/false = MCP tools are not available to the model
MCP_ENABLED=false
# MCP servers are configured per chat using /agentur mcp ... commands and stored in integrations/mcp/servers.json
# MCP operation timeout
MCP_TIMEOUT_MS=20000
# Maximum MCP tool/resource result size
MCP_MAX_RESPONSE_BYTES=262144
# DEV ONLY: disable Node.js TLS certificate checks for internal/self-signed MCP endpoints. Leave empty/unset in production.
NODE_TLS_REJECT_UNAUTHORIZED=
