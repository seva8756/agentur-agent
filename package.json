{
  "name": "agentur-chat-agent",
  "version": "1.0.0",
  "description": "Standalone file-backed Telegram group chat AI agent MVP",
  "main": "dist/src/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"dev/**/*.ts\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.45.1",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.10",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
